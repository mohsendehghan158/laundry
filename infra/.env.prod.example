# Production settings. Copy to infra/.env.prod and fill in; never commit that file.
APP_NAME=Laundry
# Generate with: php artisan key:generate --show
APP_KEY=
APP_URL=https://laundry.example.ir
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

# Domain served by Caddy with automatic HTTPS.
SITE_ADDRESS=laundry.example.ir

DB_CONNECTION=pgsql
DB_PORT=5432
DB_DATABASE=laundry
DB_USERNAME=laundry
DB_PASSWORD=

REDIS_CLIENT=phpredis
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_COOKIE=laundry_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=laundry.example.ir

CACHE_STORE=redis
QUEUE_CONNECTION=redis
LOG_CHANNEL=stderr
LOG_LEVEL=warning

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@laundry.example.ir"
MAIL_FROM_NAME="${APP_NAME}"
