# Address of the Laravel API as seen from the Next.js server.
BACKEND_URL=http://127.0.0.1:8000

# Map tiles for the zone and address maps (default: OpenStreetMap's own servers,
# fine for staff screens). For the customer portal in production, use a tile
# provider you have an agreement with, and its attribution.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap
