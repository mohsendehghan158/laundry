APP_NAME=Laundry
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public address of the whole application (the reverse proxy / Next.js dev server).
APP_URL=http://localhost:3000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laundry
DB_USERNAME=laundry
DB_PASSWORD=secret

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The frontend looks for this cookie to decide whether to show the login page.
SESSION_COOKIE=laundry_session
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

# Hosts whose requests get cookie sessions: the address users open in the browser.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost,127.0.0.1:3000

CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
# Customer text messages: log (development) or kavenegar.
SMS_DRIVER=log
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
